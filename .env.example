# Copy this file to `.env` and fill in the values you need.
# It is read once on first run to populate the database; afterwards settings
# are managed through the UI (Resources tab).

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large

# --- Azure OpenAI (optional) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=

# --- Other providers (optional) ---
COHERE_API_KEY=
GOOGLE_API_KEY=
VOYAGE_API_KEY=

# --- Local models via Ollama (optional) ---
# LOCAL_MODEL=qwen2.5:7b
# LOCAL_MODEL_EMBEDDINGS=nomic-embed-text
# KH_OLLAMA_URL=http://localhost:11434/v1/

# --- Application ---
# Default admin account created on first run. Change these.
KH_FEATURE_USER_MANAGEMENT_ADMIN=admin
KH_FEATURE_USER_MANAGEMENT_PASSWORD=admin

# --- GraphRAG (optional) ---
# GRAPHRAG_API_KEY=
# USE_NANO_GRAPHRAG=false
# USE_LIGHTRAG=false
# USE_CUSTOMIZED_GRAPHRAG_SETTING=false
